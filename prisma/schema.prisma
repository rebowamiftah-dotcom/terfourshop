generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Address {
  id             String  @id @db.Char(36)
  user_id        String  @db.Char(36)
  recipient_name String  @db.VarChar(50)
  phone          String  @db.VarChar(13)
  address        String  @db.Text
  city           String  @db.VarChar(100)
  province       String  @db.VarChar(100)
  postal_code    String  @db.VarChar(10)
  is_default     Boolean @default(false)
  users          User    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_addresses_user")
  orders         Order[]

  @@index([user_id], map: "fk_addresses_user")
  @@map("addresses")
}

model BusinessType {
  id                String           @id @db.Char(36)
  name              String           @unique(map: "name") @db.VarChar(100)
  code              String           @unique(map: "code") @db.VarChar(50)
  description       String?          @db.VarChar(255)
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now()) @db.Timestamp(0)
  updated_at        DateTime         @default(now()) @db.Timestamp(0)
  seller_businesses SellerBusiness[]

  @@map("business_types")
}

model CartItem {
  id         String   @id @db.Char(36)
  cart_id    String   @db.Char(36)
  product_id String   @db.Char(36)
  quantity   Int      @default(1) @db.UnsignedInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  carts      Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade, map: "fk_cart_items_cart")
  products   Product  @relation(fields: [product_id], references: [id], map: "fk_cart_items_product")

  @@unique([cart_id, product_id], map: "unique_cart_product")
  @@index([product_id], map: "fk_cart_items_product")
  @@map("cart_items")
}

model Cart {
  id         String     @id @db.Char(36)
  user_id    String     @unique(map: "user_id") @db.Char(36)
  created_at DateTime   @default(now()) @db.Timestamp(0)
  updated_at DateTime   @default(now()) @db.Timestamp(0)
  cart_items CartItem[]
  users      User       @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_carts_user")

  @@map("carts")
}

model Category {
  id                 String            @id @db.Char(36)
  name               String            @unique(map: "name") @db.VarChar(100)
  slug               String            @unique(map: "slug") @db.VarChar(120)
  description        String?           @db.Text
  created_at         DateTime          @default(now()) @db.Timestamp(0)
  updated_at         DateTime          @default(now()) @db.Timestamp(0)
  product_categories ProductCategory[]

  @@map("categories")
}

model Courier {
  id         String     @id @db.Char(36)
  code       String     @unique(map: "code") @db.VarChar(50)
  name       String     @unique(map: "name") @db.VarChar(100)
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now()) @db.Timestamp(0)
  updated_at DateTime   @default(now()) @db.Timestamp(0)
  shipments  Shipment[]

  @@map("couriers")
}

model OrderItem {
  id              String      @id @db.Char(36)
  seller_order_id String      @db.Char(36)
  product_id      String      @db.Char(36)
  product_name    String      @db.VarChar(200)
  price           Decimal     @default(1.00) @db.Decimal(15, 2)
  quantity        Int         @default(1) @db.UnsignedInt
  subtotal        Decimal     @default(1.00) @db.Decimal(15, 2)
  created_at      DateTime    @default(now()) @db.Timestamp(0)
  products        Product     @relation(fields: [product_id], references: [id], map: "fk_order_items_product")
  seller_orders   SellerOrder @relation(fields: [seller_order_id], references: [id], onDelete: Cascade, map: "fk_order_items_seller_order")
  reviews         Review?

  @@index([product_id], map: "fk_order_items_product")
  @@index([seller_order_id], map: "fk_order_items_seller_order")
  @@map("order_items")
}

model Order {
  id            String        @id @db.Char(36)
  user_id       String        @db.Char(36)
  address_id    String?       @db.Char(36)
  order_number  String        @unique(map: "order_number") @db.VarChar(50)
  status        orders_status @default(PENDING)
  subtotal      Decimal       @default(1.00) @db.Decimal(15, 2)
  shipping_cost Decimal       @default(0.00) @db.Decimal(15, 2)
  total_amount  Decimal       @default(1.00) @db.Decimal(15, 2)
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @default(now()) @db.Timestamp(0)
  addresses     Address?      @relation(fields: [address_id], references: [id], map: "fk_orders_address")
  users         User          @relation(fields: [user_id], references: [id], map: "fk_orders_user")
  payments      Payment?
  seller_orders SellerOrder[]

  @@index([address_id], map: "fk_orders_address")
  @@index([user_id], map: "fk_orders_user")
  @@map("orders")
}

model PaymentMethod {
  id          String    @id @db.Char(36)
  code        String    @unique(map: "code") @db.VarChar(50)
  name        String    @unique(map: "name") @db.VarChar(100)
  description String?   @db.VarChar(255)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_at  DateTime  @default(now()) @db.Timestamp(0)
  payments    Payment[]

  @@map("payment_methods")
}

model Payment {
  id                String                  @id @db.Char(36)
  order_id          String                  @unique(map: "order_id") @db.Char(36)
  payment_method_id String                  @db.Char(36)
  payment_status    payments_payment_status @default(PENDING)
  transaction_id    String?                 @unique(map: "transaction_id") @db.VarChar(150)
  paid_at           DateTime?               @db.Timestamp(0)
  created_at        DateTime                @default(now()) @db.Timestamp(0)
  updated_at        DateTime                @default(now()) @db.Timestamp(0)
  payment_methods   PaymentMethod           @relation(fields: [payment_method_id], references: [id], map: "fk_payments_method")
  orders            Order                   @relation(fields: [order_id], references: [id], map: "fk_payments_order")

  @@index([payment_method_id], map: "fk_payments_method")
  @@map("payments")
}

model ProductCategory {
  product_id  String   @db.Char(36)
  category_id String   @db.Char(36)
  categories  Category @relation(fields: [category_id], references: [id], onDelete: Cascade, map: "fk_product_categories_category")
  products    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_product_categories_product")

  @@id([product_id, category_id])
  @@index([category_id], map: "fk_product_categories_category")
  @@map("product_categories")
}

model ProductImage {
  id         String   @id @db.Char(36)
  product_id String   @db.Char(36)
  image_url  String   @db.VarChar(500)
  is_primary Boolean  @default(false)
  sort_order Int      @default(0) @db.UnsignedSmallInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  products   Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_product_images_product")

  @@index([product_id], map: "fk_product_images_product")
  @@map("product_images")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Product {
  id                 String            @id @db.Char(36)
  store_id           String            @db.Char(36)
  name               String            @db.VarChar(150)
  slug               String            @unique(map: "slug") @db.VarChar(180)
  description        String?           @db.Text
  price              Decimal           @db.Decimal(15, 2)
  stock              Int               @default(0) @db.UnsignedInt
  status             products_status   @default(DRAFT)
  created_at         DateTime          @default(now()) @db.Timestamp(0)
  updated_at         DateTime          @default(now()) @db.Timestamp(0)
  cart_items         CartItem[]
  order_items        OrderItem[]
  product_categories ProductCategory[]
  product_images     ProductImage[]
  stores             Store             @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "fk_products_store")

  @@index([store_id], map: "fk_products_store")
  @@map("products")
}

model Profile {
  id         String           @id @db.Char(36)
  user_id    String           @unique(map: "user_id") @db.Char(36)
  full_name  String           @db.VarChar(60)
  avatar     String?          @db.VarChar(500)
  gender     profiles_gender?
  birth_date DateTime?        @db.Date
  created_at DateTime         @default(now()) @db.Timestamp(0)
  updated_at DateTime         @default(now()) @db.Timestamp(0)
  users      User             @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_profiles_user")

  @@map("profiles")
}

model Review {
  id            String    @id @db.Char(36)
  user_id       String    @db.Char(36)
  order_item_id String    @unique(map: "unique_reviews_order_item") @db.Char(36)
  rating        Int       @db.UnsignedTinyInt
  comment       String?   @db.Text
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime  @default(now()) @db.Timestamp(0)
  order_items   OrderItem @relation(fields: [order_item_id], references: [id], map: "fk_reviews_order_item")
  users         User      @relation(fields: [user_id], references: [id], map: "fk_reviews_user")

  @@index([user_id], map: "fk_reviews_user")
  @@map("reviews")
}

model Role {
  id          String   @id @db.Char(36)
  name        String   @unique(map: "name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  level       Int      @db.UnsignedTinyInt
  created_at  DateTime @default(now()) @db.Timestamp(0)
  users       User[]

  @@map("roles")
}

model SellerBusiness {
  id                           String       @id @db.Char(36)
  seller_id                    String       @unique(map: "seller_id") @db.Char(36)
  business_name                String       @db.VarChar(150)
  business_type_id             String       @db.Char(36)
  tax_number                   String?      @db.Char(16)
  business_registration_number String?      @db.Char(13)
  created_at                   DateTime     @default(now()) @db.Timestamp(0)
  updated_at                   DateTime     @default(now()) @db.Timestamp(0)
  sellers                      Seller       @relation(fields: [seller_id], references: [id], onDelete: Cascade, map: "fk_seller_businesses_seller")
  business_types               BusinessType @relation(fields: [business_type_id], references: [id], map: "fk_seller_businesses_type")

  @@index([business_type_id], map: "fk_seller_businesses_type")
  @@map("seller_businesses")
}

model SellerDocument {
  id                  String                               @id @db.Char(36)
  seller_id           String                               @db.Char(36)
  document_type       seller_documents_document_type
  document_number     String?                              @db.VarChar(100)
  document_url        String?                              @db.VarChar(500)
  verification_status seller_documents_verification_status @default(PENDING)
  verified_at         DateTime?                            @db.Timestamp(0)
  created_at          DateTime                             @default(now()) @db.Timestamp(0)
  updated_at          DateTime                             @default(now()) @db.Timestamp(0)
  sellers             Seller                               @relation(fields: [seller_id], references: [id], onDelete: Cascade, map: "fk_seller_documents_seller")

  @@index([seller_id], map: "fk_seller_documents_seller")
  @@map("seller_documents")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model SellerOrder {
  id            String               @id @db.Char(36)
  order_id      String               @db.Char(36)
  store_id      String               @db.Char(36)
  order_number  String               @unique(map: "order_number") @db.VarChar(70)
  status        seller_orders_status @default(PENDING)
  subtotal      Decimal              @default(1.00) @db.Decimal(15, 2)
  shipping_cost Decimal              @default(0.00) @db.Decimal(15, 2)
  total_amount  Decimal              @default(1.00) @db.Decimal(15, 2)
  created_at    DateTime             @default(now()) @db.Timestamp(0)
  updated_at    DateTime             @default(now()) @db.Timestamp(0)
  order_items   OrderItem[]
  orders        Order                @relation(fields: [order_id], references: [id], map: "fk_seller_orders_order")
  stores        Store                @relation(fields: [store_id], references: [id], map: "fk_seller_orders_store")
  shipments     Shipment?

  @@index([order_id], map: "fk_seller_orders_order")
  @@index([store_id], map: "fk_seller_orders_store")
  @@map("seller_orders")
}

model Seller {
  id                  String                      @id @db.Char(36)
  user_id             String                      @unique(map: "user_id") @db.Char(36)
  seller_type         sellers_seller_type         @default(INDIVIDUAL)
  verification_status sellers_verification_status @default(PENDING)
  verified_at         DateTime?                   @db.Timestamp(0)
  created_at          DateTime                    @default(now()) @db.Timestamp(0)
  updated_at          DateTime                    @default(now()) @db.Timestamp(0)
  seller_businesses   SellerBusiness?
  seller_documents    SellerDocument[]
  users               User                        @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_sellers_user")
  stores              Store[]

  @@map("sellers")
}

model ShipmentProof {
  id          String   @id @db.Char(36)
  shipment_id String   @db.Char(36)
  photo_url   String   @db.VarChar(500)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  shipments   Shipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade, map: "fk_shipment_proofs_shipment")

  @@index([shipment_id], map: "fk_shipment_proofs_shipment")
  @@map("shipment_proofs")
}

model Shipment {
  id              String           @id @db.Char(36)
  seller_order_id String           @unique(map: "seller_order_id") @db.Char(36)
  courier_id      String           @db.Char(36)
  service         String?          @db.VarChar(50)
  tracking_number String?          @unique(map: "tracking_number") @db.VarChar(100)
  status          shipments_status @default(PENDING)
  shipped_at      DateTime?        @db.Timestamp(0)
  delivered_at    DateTime?        @db.Timestamp(0)
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  updated_at      DateTime         @default(now()) @db.Timestamp(0)
  shipment_proofs ShipmentProof[]
  couriers        Courier          @relation(fields: [courier_id], references: [id], map: "fk_shipments_courier")
  seller_orders   SellerOrder      @relation(fields: [seller_order_id], references: [id], map: "fk_shipments_seller_order")

  @@index([courier_id], map: "fk_shipments_courier")
  @@map("shipments")
}

model Store {
  id            String        @id @db.Char(36)
  seller_id     String        @db.Char(36)
  name          String        @db.VarChar(150)
  store_code    String        @unique(map: "store_code") @db.Char(3)
  slug          String        @unique(map: "slug") @db.VarChar(180)
  description   String?       @db.Text
  logo          String?       @db.VarChar(500)
  phone         String?       @db.VarChar(13)
  address       String?       @db.Text
  city          String?       @db.VarChar(100)
  province      String?       @db.VarChar(100)
  postal_code   String?       @db.VarChar(10)
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @default(now()) @db.Timestamp(0)
  products      Product[]
  seller_orders SellerOrder[]
  sellers       Seller        @relation(fields: [seller_id], references: [id], onDelete: Cascade, map: "fk_stores_seller")

  @@index([seller_id], map: "fk_stores_seller")
  @@map("stores")
}

model Account {
  id                String @id @db.Char(36)
  userId            String @db.Char(36)
  type              String @db.VarChar(50)
  provider          String @db.VarChar(50)
  providerAccountId String @db.VarChar(255)

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String? @db.VarChar(50)
  scope         String? @db.VarChar(255)
  id_token      String? @db.Text
  session_state String? @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model User {
  id         String    @id @db.Char(36)
  username   String    @unique(map: "username") @db.VarChar(50)
  email      String    @unique(map: "email") @db.VarChar(255)
  password   String?   @db.VarChar(255)
  phone      String?   @unique(map: "phone") @db.VarChar(13)
  role_id    String    @db.Char(36)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime  @default(now()) @db.Timestamp(0)
  accounts   Account[]
  addresses  Address[]
  carts      Cart?
  orders     Order[]
  profiles   Profile?
  reviews    Review[]
  sellers    Seller?
  roles      Role      @relation(fields: [role_id], references: [id], map: "fk_users_role")

  @@index([role_id], map: "fk_users_role")
  @@map("users")
}

enum seller_documents_document_type {
  IDENTITY
  TAX
  BUSINESS_REGISTRATION
  OTHER
}

enum sellers_seller_type {
  INDIVIDUAL
  BUSINESS
}

enum payments_payment_status {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum sellers_verification_status {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum orders_status {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum profiles_gender {
  MALE
  FEMALE
}

enum seller_orders_status {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum seller_documents_verification_status {
  PENDING
  VERIFIED
  REJECTED
}

enum shipments_status {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum products_status {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model members {
  id         String   @id @db.Char(36)
  user_id    String   @unique @db.Char(36)
  full_name  String   @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  phone      String   @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  // Relasi ke tabel users
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
